# Copy this file to .env and replace the example values.
DVARR_AUTH_USER=replace-with-username
DVARR_AUTH_PASS=replace-with-a-long-random-password
DVARR_TSDB_API_KEY=
PROXY_ALLOWED_HOSTS=media.example.com

# The services bind to localhost by default. Set to 0.0.0.0 only when LAN access is needed.
STREAM_BIND_IP=127.0.0.1
FRUIT_HOST_PORT=30080
# Set this to an address reachable by your clients (for example, your server's Tailscale IP).
FRUIT_SERVER_URL=http://100.100.133.10:30080
TZ=Asia/Kuala_Lumpur

SPORTSDB_API_KEY=123
