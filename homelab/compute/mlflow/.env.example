# MLflow tracking server deployment environment — copy to .env and fill in.
# cp .env.example .env
#
# Deployed on aeacus-data-handler at ~/mlflow/. See README.md for the full
# setup (Postgres DB creation, MinIO bucket, Cloudflare tunnel hostname).

# --- Postgres backend store ---
# Role + database created once via:
#   docker exec -i ereuna_postgres psql -U ereuna -d ereuna -v ON_ERROR_STOP=1 <<SQL
#   CREATE ROLE mlflow_user WITH LOGIN PASSWORD '<this value>';
#   CREATE DATABASE mlflow OWNER mlflow_user;
#   SQL
# Generate with: openssl rand -hex 24
MLFLOW_POSTGRES_PASSWORD=change-me-strong-random-value

# --- MinIO artifact store ---
# KNOWN LIMITATION (as of 2026-11-08): MinIO's `mc` client binary
# (dl.min.io) and the `minio/mc` Docker image both now return
# access-denied — MinIO Inc. locked down free distribution of their admin
# tooling. Without `mc admin user add`/`policy attach`, a bucket-scoped
# service account could not be created, so this currently uses the native
# MinIO server's ROOT credentials (see /etc/systemd/system/minio.service on
# aeacus-data-handler) directly. TODO: revisit once a scoped-credential path
# is available (MinIO Python SDK admin support, raw signed admin-API calls,
# or a restored client distribution) and rotate to a restricted key then.
# Bucket `mlflow-artifacts` was created via: aws --endpoint-url
# http://localhost:9000 s3 mb s3://mlflow-artifacts (aws cli is already
# available on the host via snap; boto3 via apt).
MLFLOW_MINIO_ACCESS_KEY=change-me-minio-root-user
MLFLOW_MINIO_SECRET_KEY=change-me-minio-root-password

# --- Basic auth (MLflow's experimental basic-auth app) ---
# Generate with: openssl rand -hex 16
MLFLOW_ADMIN_USERNAME=admin
MLFLOW_ADMIN_PASSWORD=change-me-strong-random-value
# CSRF signing key, must stay constant across restarts/replicas.
# Generate with: openssl rand -hex 32
MLFLOW_FLASK_SERVER_SECRET_KEY=change-me-strong-random-value

# --- DNS-rebinding guard (mlflow's --allowed-hosts) ---
# mlflow's default "localhost + private IPs" allowlist does NOT cover
# Tailscale/CGNAT addresses (100.64.0.0/10), so every hostname/IP a client
# will put in the Host header must be listed explicitly, INCLUDING the
# ":5001" port-qualified form for anyone connecting by IP:port rather than
# through the Cloudflare hostname. Adding a new training host means adding
# its address here and recreating the container.
MLFLOW_ALLOWED_HOSTS=localhost,127.0.0.1,localhost:5001,127.0.0.1:5001,<data-handler-tailscale-ip>,<data-handler-tailscale-ip>:5001,tracking.ereuna.org
