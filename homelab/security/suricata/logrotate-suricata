# /etc/logrotate.d/suricata — eve.json carries flow records too, so keep it short.
/var/log/suricata/*.log /var/log/suricata/*.json {
    daily
    rotate 3
    missingok
    notifempty
    compress
    delaycompress
    sharedscripts
    postrotate
        /bin/kill -HUP $(cat /run/suricata.pid 2>/dev/null) 2>/dev/null || true
    endscript
}
