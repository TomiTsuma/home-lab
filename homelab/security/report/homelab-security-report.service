[Unit]
Description=Homelab security posture report (evening email)
After=network-online.target suricata.service
Wants=network-online.target

[Service]
Type=oneshot
# report.env holds REPORT_TO=<address>; created by you on pve, not in the repo.
EnvironmentFile=-/etc/homelab-security/report.env
ExecStart=/usr/bin/flock /run/homelab-security.lock /usr/bin/python3 /opt/homelab-security/security_report.py 
TimeoutStartSec=30min
Nice=10
IOSchedulingClass=idle
