# Lyre deployment environment — copy to .env and fill in real values.
# cp .env.example .env

# --- App ---
# RapidAPI key for the spotify81 search provider
RAPIDAPI_KEY=your-rapidapi-key-here

# Where Lyre's backend state/db lives on the host (bind-mounted to /root/.lyre)
LYRE_STATE_DIR=~/.lyre

# Host path to the music library the backend reads (read-only mount)
LYRE_MUSIC_DIR=/mnt/nas/data-store/media/music

# --- GlitchTip (bundled error tracking, Sentry-compatible) ---
# Generate strong random values for these — do not reuse the examples below.
#   openssl rand -hex 24
GLITCHTIP_POSTGRES_PASSWORD=change-me-strong-random-value
GLITCHTIP_SECRET_KEY=change-me-strong-random-value

# Public URL GlitchTip is served at — fronted by the "Ereuna" Cloudflare
# Tunnel (dashboard-managed, tunnel ID b76fe173-5ecd-4cc2-b76f-2c48e55b11af on
# aeacus-data-handler) routing logs.ereuna.org -> http://localhost:8085.
GLITCHTIP_DOMAIN=https://logs.ereuna.org

# DSN the backend container uses to talk to the GlitchTip container directly
# over the compose network (lower latency, works even if the tunnel/DNS is
# down). Get the real value after first boot: GlitchTip UI > create a Team >
# create a Project under it > Settings > Client Keys (DSN) — then swap that
# DSN's host from the public domain to glitchtip:8000, e.g.
# http://<project-key>@glitchtip:8000/<project-id>. See README.md for the
# exact project this homelab uses ("lyre-backend").
GLITCHTIP_INTERNAL_DSN=http://REPLACE_WITH_PROJECT_KEY@glitchtip:8000/1

# DSNs for external/browser-facing error reporting (frontend build + any
# external tooling), via the public GLITCHTIP_DOMAIN above. Get the real
# values from the same Client Keys page as GLITCHTIP_INTERNAL_DSN.
VITE_GLITCHTIP_DSN=https://REPLACE_WITH_PROJECT_KEY@logs.ereuna.org/1
GLITCHTIP_DSN=https://REPLACE_WITH_PROJECT_KEY@logs.ereuna.org/2
