# Copy to .env (chmod 600) alongside docker-compose.yml, fill in real values.
# Consumed by the litellm service (env_file:) — see litellm-config.yaml for how
# these map to model entries.

# Anthropic API key. Created at https://platform.claude.com (not console.anthropic.com,
# which now redirects there) — keys from that console use the sk-ant-usr-... prefix,
# not the older sk-ant-api03-... format some docs/training data still expect. Both are
# valid; don't assume a key is wrong just because the prefix looks unfamiliar.
ANTHROPIC_API_KEY=sk-ant-usr-...

# Any random strong string — this is LiteLLM's own proxy auth key, not an upstream
# provider key. Open WebUI's OpenAI-connection API key must match this value.
LITELLM_MASTER_KEY=sk-litellm-...

# NOTE: compose also reads this file for ${...} interpolation in docker-compose.yml (not
# only litellm's env_file); `:?` vars below make compose refuse to start if unset.

# Stable Open WebUI JWT signing key (otherwise regenerated on every container recreate,
# logging everyone out). Generate with: openssl rand -hex 32
WEBUI_SECRET_KEY=

# Exa search API key (Open WebUI built-in web search engine). https://dashboard.exa.ai
EXA_API_KEY=

# --- mcp-tools ---------------------------------------------------------------------
# LlamaParse (LlamaCloud) key for parse_document. https://cloud.llamaindex.ai
LLAMA_CLOUD_API_KEY=llx-...
# scrape.do token for web_search_scrapedo / fetch_url. https://dashboard.scrape.do
SCRAPEDO_TOKEN=
# Scoped MinIO user that can only touch bucket openwebui-files on s3.ereuna.org.
# Created on aeacus-data-handler; see README "MCP tool server".
S3_ACCESS_KEY=openwebui-mcp
S3_SECRET_KEY=

# --- Google Workspace (Google-hosted MCP servers) ---------------------------------
# OAuth "Web application" client from Google Cloud Console. Consumed only by
# google-mcp/connect_google_mcp.py (copied into Open WebUI's config DB), not by compose.
GOOGLE_OAUTH_CLIENT_ID=....apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-...
