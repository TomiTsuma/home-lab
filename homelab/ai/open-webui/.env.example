# Copy to .env (chmod 600) alongside docker-compose.yml, fill in real values.
# Consumed by the litellm service (env_file:) — see litellm-config.yaml for how
# these map to model entries.

# Anthropic API key. Created at https://platform.claude.com (not console.anthropic.com,
# which now redirects there) — keys from that console use the sk-ant-usr-... prefix,
# not the older sk-ant-api03-... format some docs/training data still expect. Both are
# valid; don't assume a key is wrong just because the prefix looks unfamiliar.
ANTHROPIC_API_KEY=sk-ant-usr-...

# Any random strong string — this is LiteLLM's own proxy auth key, not an upstream
# provider key. Open WebUI's OpenAI-connection API key must match this value.
LITELLM_MASTER_KEY=sk-litellm-...
